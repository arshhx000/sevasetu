Step 1 — Backend Setup
Install dependencies
npm install multer cloudinary multer-storage-cloudinary
📁 Create cloudinary.js
const cloudinary = require('cloudinary').v2;

cloudinary.config({
  cloud_name: 'YOUR_CLOUD_NAME',
  api_key: 'YOUR_API_KEY',
  api_secret: 'YOUR_API_SECRET'
});

module.exports = cloudinary;
📁 Create upload.js (Multer config)
const multer = require('multer');
const { CloudinaryStorage } = require('multer-storage-cloudinary');
const cloudinary = require('./cloudinary');

const storage = new CloudinaryStorage({
  cloudinary,
  params: {
    folder: 'complaints',
    allowed_formats: ['jpg', 'png', 'jpeg']
  }
});

const upload = multer({ storage });

module.exports = upload;
🔧 Step 2 — Complaint API
Update your route
const express = require('express');
const router = express.Router();
const upload = require('../utils/upload');

router.post('/complaint', upload.single('image'), async (req, res) => {
  try {
    const { title, description } = req.body;

    const imageUrl = req.file?.path; // cloudinary URL

    const complaint = new Complaint({
      title,
      description,
      image: imageUrl,
      user: req.user.id
    });

    await complaint.save();

    res.json(complaint);
  } catch (err) {
    res.status(500).json({ message: err.message });
  }
});
🗄️ Step 3 — MongoDB Model
const mongoose = require('mongoose');

const complaintSchema = new mongoose.Schema({
  title: String,
  description: String,
  image: String, // URL
  user: { type: mongoose.Schema.Types.ObjectId, ref: 'User' }
});

module.exports = mongoose.model('Complaint', complaintSchema);
🎨 Step 4 — Frontend (React)
Add file input
const [form, setForm] = useState({
  title: '',
  description: '',
  image: null
});

<input
  type="file"
  accept="image/*"
  onChange={(e) => setForm({ ...form, image: e.target.files[0] })}
/>
Submit using FormData
const handleSubmit = async () => {
  const data = new FormData();

  data.append('title', form.title);
  data.append('description', form.description);
  data.append('image', form.image);

  await fetch('http://localhost:5000/api/complaint', {
    method: 'POST',
    body: data,
    headers: {
      Authorization: `Bearer ${token}`
    }
  });
};
🖼️ Step 5 — Show Image
<img src={complaint.image} alt="complaint" className="w-32 rounded-lg" />
⚠️ Important Notes
1. Don’t use JSON

File upload needs:

Content-Type: multipart/form-data

👉 FormData handles this automatically

2. Limit file size
const upload = multer({
  storage,
  limits: { fileSize: 2 * 1024 * 1024 } // 2MB
});
3. Security (must do)
fileFilter: (req, file, cb) => {
  if (!file.mimetype.startsWith('image')) {
    return cb(new Error('Only images allowed'), false);
  }
  cb(null, true);
}
🎯 Final Flow
User selects image → React FormData →
Express + Multer →
Cloudinary →
URL stored in MongoDB →
Displayed in UI